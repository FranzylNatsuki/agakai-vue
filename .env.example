# Supabase (leave blank until the backend is wired up)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Gemini API (Free tier key from Google AI Studio: https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3-flash-preview
VITE_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Groq API for Whisper STT (Free tier key from https://console.groq.com/keys)
# Optional: if left blank, STT falls back to Gemini multimodal audio transcription
VITE_GROQ_API_KEY=
VITE_WHISPER_MODEL=whisper-large-v3

# When "true", services return sample data so the UI can be previewed
# without a backend. Note: Voice Assistant will automatically use Gemini
# once VITE_GEMINI_API_KEY is set.
VITE_USE_MOCK_DATA=true
