{
  "name": "agakai-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:voice": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.mjs",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@fontsource/inter": "^5.3.0",
    "@ionic/vue": "^8.4.0",
    "@ionic/vue-router": "^8.4.0",
    "@supabase/supabase-js": "^2.45.0",
    "dompurify": "^3.2.0",
    "ionicons": "^7.4.0",
    "leaflet": "^1.9.4",
    "marked": "^14.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
