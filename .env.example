# Public client settings
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_USE_MOCK_DATA=true

# Provider secrets belong in Supabase Edge Function Secrets, never VITE_ variables:
# GEMINI_API_KEY
# ELEVENLABS_API_KEY
# ELEVENLABS_VOICE_ID
# Optional: ELEVENLABS_STT_MODEL=scribe_v2, ELEVENLABS_TTS_MODEL=eleven_v3
# Gemini defaults to gemini-3.5-flash-lite, then gemini-3.1-flash-lite.
