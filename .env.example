# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Gemini: chat and memory only (VITE_* values are visible to browser clients)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3-flash-preview

# ElevenLabs: the ONLY STT and TTS provider. Never prefix these secrets with VITE_.
# Local Vite gateway reads these server-side; restart npm run dev after changes.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_v3

# Local-only gateway includes a realtime Scribe token endpoint.
# Public/native deployment needs an authenticated gateway.
VITE_ELEVENLABS_PROXY_URL=/api/voice

# Sample profile/benefits and chat when Gemini is unconfigured.
# Speech still uses ElevenLabs; requests consume account quota and may incur charges.
VITE_USE_MOCK_DATA=true
