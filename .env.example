# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Gemini: chat and memory only (VITE_* values are visible to browser clients)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3-flash-preview

# ElevenLabs secrets are stored only in Supabase Edge Function secrets:
# ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID (required)
# ELEVENLABS_STT_MODEL=scribe_v2, ELEVENLABS_TTS_MODEL=eleven_v3 (optional)
# Never use VITE_ prefixes for these provider secrets.

# Sample profile/benefits and chat when Gemini is unconfigured.
# Speech still uses ElevenLabs; requests consume account quota and may incur charges.
VITE_USE_MOCK_DATA=true
